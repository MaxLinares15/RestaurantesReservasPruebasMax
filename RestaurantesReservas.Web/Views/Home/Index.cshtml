@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div id="homeCarousel" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/slide1.jpg" class="d-block w-100" alt="Slide 1">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4">Bienvenido a Restaurantes Reservas</h1>
                    <p class="lead">Disfruta de una experiencia culinaria única con nosotros.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/slide2.jpg" class="d-block w-100" alt="Slide 2">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4">Explora Nuestro Menú</h1>
                    <p class="lead">Platos exquisitos preparados con los ingredientes más frescos.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/slide3.jpg" class="d-block w-100" alt="Slide 3">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4">Haz tu Reservación</h1>
                    <p class="lead">Reserva en línea de manera rápida y sencilla.</p>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#homeCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#homeCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

    <div class="text-center mt-4">
        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register" role="button">Haz tu Reservación</a>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 text-center">
            <h2><i class="fas fa-utensils"></i> Nuestro Menú</h2>
            <p>Descubre una variedad de platos exquisitos preparados con los ingredientes más frescos.</p>
            <img src="~/images/menu.jpg" class="img-fluid rounded" alt="Menú">
        </div>
        <div class="col-md-4 text-center">
            <h2><i class="fas fa-home"></i> Ambiente Acogedor</h2>
            <p>Disfruta de un ambiente cálido y acogedor, perfecto para cualquier ocasión.</p>
            <img src="~/images/ambiente.jpg" class="img-fluid rounded" alt="Ambiente">
        </div>
        <div class="col-md-4 text-center">
            <h2><i class="fas fa-comments"></i> Opiniones de Clientes</h2>
            <p>Lee lo que nuestros clientes tienen que decir sobre su experiencia con nosotros.</p>
            <img src="~/images/opiniones.jpg" class="img-fluid rounded" alt="Opiniones">
        </div>
    </div>
</div>
